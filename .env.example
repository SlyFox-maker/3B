# 1 = classic nfqws, 2 = Lua-based nfqws2
NFQWS_ENGINE=1
QUEUE_NUM=29
NFQWS_TRACE=1
NFQWS_FAKE_SNI=dzen.ru
NFQWS_TCP_PORTS=80,443,5222,5242
NFQWS_UDP_PORTS=443,3478,590:65535
NFQWS2_TCP_PKT_OUT=20
NFQWS2_TCP_PKT_IN=10
NFQWS2_UDP_PKT_OUT=6
NFQWS2_UDP_PKT_IN=4

# test-strategies.sh defaults. Domain can also be passed as command arguments.
STRATEGY_TEST_DOMAINS=
STRATEGY_TEST_LEVEL=standard
STRATEGY_TEST_REPEATS=3
STRATEGY_TEST_PARALLEL=0
STRATEGY_TEST_IPV=4
STRATEGY_TEST_CURL_MAX_TIME=3
STRATEGY_TEST_BATCH=0
# Optional fixed frontends for domain-specific testing (space-separated).
# STRATEGY_TEST_IP_OVERRIDES="whatsapp.com=57.144.251.32 web.whatsapp.com=57.144.251.32"

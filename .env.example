# 1 = classic nfqws, 2 = Lua-based nfqws2
NFQWS_ENGINE=1
QUEUE_NUM=29
NFQWS_TRACE=1
NFQWS_FAKE_SNI=dzen.ru
NFQWS_TCP_PORTS=80,443,5222,5242
NFQWS_UDP_PORTS=443,3478,590:65535
NFQWS2_TCP_PKT_OUT=20
NFQWS2_TCP_PKT_IN=10
NFQWS2_UDP_PKT_OUT=6
NFQWS2_UDP_PKT_IN=4
NFQWS2_UID=0
NFQWS2_GID=0

# test-strategies.sh defaults. Domain can also be passed as command arguments.
STRATEGY_TEST_DOMAINS=
# Оставьте пустыми, чтобы test-strategies.sh спросил значения перед запуском.
STRATEGY_TEST_LEVEL=
STRATEGY_TEST_REPEATS=
STRATEGY_TEST_PARALLEL=0
STRATEGY_TEST_IPV=4
STRATEGY_TEST_CURL_MAX_TIME=3
STRATEGY_TEST_BATCH=0
STRATEGY_TEST_PROGRESS=1
# Сохранённая оценка общего количества; если >0, медленный предварительный подсчёт пропускается.
STRATEGY_TEST_TOTAL=
# 0 = полный проход; 1 = остановиться после первой стратегии, прошедшей все REPEATS
STRATEGY_TEST_STOP_AFTER_FOUND=
# Пустое значение включает интерактивный вопрос; Enter оставляет обычный DNS.
STRATEGY_TEST_IP_OVERRIDES=
# Пример: STRATEGY_TEST_IP_OVERRIDES="whatsapp.com=57.144.251.32 web.whatsapp.com=57.144.251.32"

TARGET_IP=72.56.124.34
TARGET_PORT=25531
NFQUEUE_NUM=129
TEST_DURATION_SECONDS=60
TEST_ATTEMPTS=5
CONNECT_TIMEOUT_SECONDS=5
ENABLE_PACKET_CAPTURE=true
ENABLE_SYNDATA=true
REPORT_FORMATS=json,markdown

# Adaptive phase limit; each phase runs the same bounded schedule.
ADAPTIVE_DURATION_SECONDS=1200
BURST_CONNECTIONS=5
BURST_RATE_PER_SECOND=1
RECOVERY_INTERVAL_SECONDS=15
RECOVERY_SAMPLES=8

# TLS is attempted only when a compatible TLS service and its hostname are known.
TLS_TEST_PORT=0
TLS_SERVER_NAME=

# Add only ports confirmed to have listening services on your own VPS.
PORT_COMPARISON_PORTS=
PORTS_VERIFIED_ON_VPS=false

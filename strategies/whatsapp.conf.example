# WhatsApp TCP: known Meta/WhatsApp networks.
# This hard IP filter is intentionally placed before the hostname profile.
--new
--filter-tcp=80,443,5222,5242
--ipset=./ipsets/whatsapp-ips.txt
--dpi-desync=multisplit
--dpi-desync-split-seqovl=2
--dpi-desync-split-pos=1
--dpi-desync-fooling=md5sig
--dpi-desync-any-protocol
--dpi-desync-cutoff=d4
--comment="WhatsApp TCP by IP"

# WhatsApp TCP: CDN/cloud endpoints outside the known IP ranges.
--new
--filter-tcp=80,443,5222,5242
--hostlist=./hostlists/whatsapp.txt
--dpi-desync=multisplit
--dpi-desync-split-seqovl=2
--dpi-desync-split-pos=1,midsld
--dpi-desync-fooling=md5sig
--dpi-desync-cutoff=d4
--comment="WhatsApp TCP by domain"

# WhatsApp QUIC, media and calls.
--new
--filter-udp=443,3478,590-65534
--ipset=./ipsets/whatsapp-ips.txt
--dpi-desync=fake
--dpi-desync-repeats=2
--dpi-desync-any-protocol
--dpi-desync-cutoff=d3
--dpi-desync-fake-quic=@./files/fake/quic_initial_www_google_com.bin
--comment="WhatsApp UDP by IP"
